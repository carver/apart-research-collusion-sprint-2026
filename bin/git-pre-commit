#!/usr/bin/env bash
# Git's pre-commit hook: ruff, through .pre-commit-config.yaml. Link it in once per clone:
#   ln -sf ../../bin/git-pre-commit .git/hooks/pre-commit
#   ln -sf ../../bin/agent-pre-commit .git/hooks/agent-pre-commit
# pre-commit runs through uvx rather than the project's .venv: the host and the sandbox share
# this checkout, and the .venv's interpreter only exists in the sandbox.
# Agents' commits ($AI_AGENT set) also run the slower agent-pre-commit, after ruff.

# The frozen pre-sprint pilot first: a refused commit shouldn't wait on the rest.
"$(git rev-parse --show-toplevel)/bin/pilot-lock" || exit

# Format the staged Python files and stage the result first, so formatting alone never refuses
# a commit. A file that also has unstaged changes is left alone, since staging it would take
# those along; the ruff-format check below still flags it. Keep ruff's version in step with
# .pre-commit-config.yaml.
files=()
while IFS= read -r -d '' file; do
  git diff --quiet -- "$file" && files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.py')
if [ ${#files[@]} -gt 0 ]; then
  uvx -q ruff@0.16.9 format -q --force-exclude -- "${files[@]}" && git add -- "${files[@]}" || exit
fi

# Ruff's checks before the slow ones: a line too long for ruff format to fix shouldn't wait on the
# tests and pyright.
uvx pre-commit@4.7.0 run || exit

if [ -n "${AI_AGENT:-}" ] && [ -z "${AGENT_PRE_COMMIT:-}" ]; then if command -v agent-commit-gate >/dev/null; then AGENT_PRE_COMMIT=1 agent-commit-gate --run "$(dirname "$0")/agent-pre-commit"; else AGENT_PRE_COMMIT=1 "$(dirname "$0")/agent-pre-commit"; fi || exit; fi
