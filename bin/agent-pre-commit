#!/bin/sh
# Slow checks for agent commits; bin/git-pre-commit runs this first when $AI_AGENT is set.
# The repo holds only shared tools for now (no package, no tests), so the check is that
# uv.lock matches pyproject.toml and the environment syncs from it. When code and tests
# return, add back pytest and pyright here and in .github/workflows/ci.yml, run on a copy
# of what's staged (see this file's history).
set -e
repo=$(git rev-parse --show-toplevel)
cd "$repo"
uv lock --check -q
uv sync --frozen -q
