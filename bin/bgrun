#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# ///
"""Start a command in the background, detached, and print its own PID.

`cd DIR && nohup CMD > LOG &` backgrounds a subshell, so `$!` is that shell's
PID, not CMD's, and killing it leaves CMD running. bgrun starts CMD itself,
with no shell in between, in a new session, with stdin from /dev/null and
stdout and stderr in LOG, so it outlives the calling shell and the PID it
prints is CMD's. Pair it with `waitone --pid PID` and `kill PID`.

  pid=$(bgrun -o run.log -C ~/project -- python3 sweep.py --workers 8)

An earlier run's output is kept: bgrun renames a non-empty LOG to LOG plus the
time of its last write (run.log.2026-10-22T17-32-50, numbered if that name is
taken), says so on stderr, and starts a fresh LOG. --append adds to LOG
instead, after a "=== bgrun TIME: CMD" line; --truncate replaces its contents.

For a pipeline or a redirection, start a shell: bgrun -o LOG -- sh -c '...'.
The PID is then that shell's. LOG is relative to the caller's directory, not
to -C.

With --wait, bgrun stays after printing the PID, waits for CMD, then prints
"PID exited with status N after Xs" and LOG's last lines, and exits with CMD's
status (128+signal if a signal ended it). Run it with an agent's background
job runner to get one notification when CMD ends; CMD still survives if the
waiting bgrun is killed.

  bgrun --wait -o run.log -- python3 sweep.py    # e.g. as a run_in_background call

Exit status: 0 started, 1 CMD could not start (not found, not executable,
-C is not a directory, or LOG can't be moved aside or opened), 2 usage error. A failed
start leaves LOG as it was. With --wait, after a successful start: CMD's
status.
"""

import argparse
import os
import shlex
import shutil
import stat
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

CANT_START = 1
ROTATE, APPEND, TRUNCATE = (
    "rotate",
    "append",
    "truncate",
)  # what happens to an earlier run's LOG
TAIL_BYTES = 64 * 1024  # --wait reads only LOG's end, in case it has no newlines


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="bgrun",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "-o",
        "--output",
        required=True,
        metavar="LOG",
        help="file for CMD's stdout and stderr",
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "--append",
        dest="mode",
        action="store_const",
        const=APPEND,
        default=ROTATE,
        help="add to LOG after a start line, instead of moving it aside",
    )
    mode.add_argument(
        "--truncate",
        dest="mode",
        action="store_const",
        const=TRUNCATE,
        help="replace LOG's contents, instead of moving it aside",
    )
    parser.add_argument("-C", "--cwd", metavar="DIR", help="run CMD in DIR")
    parser.add_argument(
        "--wait",
        action="store_true",
        help="after printing the PID, wait for CMD, print how it ended and LOG's last lines, "
        "and exit with CMD's status",
    )
    parser.add_argument(
        "--tail",
        type=int,
        metavar="N",
        help="with --wait, LOG lines to print (default 10)",
    )
    parser.add_argument("command", nargs=argparse.REMAINDER, help="-- CMD [ARGS...]")
    args = parser.parse_args(argv)
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        parser.error("no command given")
    if args.tail is not None and not args.wait:
        parser.error("--tail needs --wait")
    if args.tail is not None and args.tail < 0:
        parser.error("--tail must be 0 or more")
    env = caller_env()
    problem = start_problem(command[0], args.cwd, env)
    if problem:
        print(f"bgrun: {problem}", file=sys.stderr)
        return CANT_START
    log = Path(args.output)
    proc = start(command, log, args.mode, args.cwd, env)
    if proc is None:
        return CANT_START
    print(proc.pid, flush=True)
    if not args.wait:
        return 0
    return wait_and_report(proc, log, 10 if args.tail is None else args.tail)


def start(
    command: list[str], log: Path, mode: str, cwd: str | None, env: dict[str, str]
) -> subprocess.Popen | None:
    """Start CMD with its output in LOG, after dealing with an earlier run's LOG as mode says.

    When CMD can't start, says why on stderr, puts LOG back as it was and returns None."""
    try:
        moved = None if mode == APPEND else rotate(log)
    except OSError as e:
        return cant(f"can't move {str(log)!r} aside: {e.strerror}")
    try:
        out = log.open("ab" if mode == APPEND else "wb")
    except OSError as e:
        put_back(moved, log)
        return cant(f"can't open {str(log)!r}: {e.strerror}")
    with out:
        size = os.fstat(out.fileno()).st_size
        if mode == APPEND:
            started = datetime.now().astimezone().isoformat(timespec="seconds")
            out.write(f"=== bgrun {started}: {shlex.join(command)}\n".encode())
            out.flush()
        try:
            proc = subprocess.Popen(
                command,
                stdin=subprocess.DEVNULL,
                stdout=out,
                stderr=subprocess.STDOUT,
                cwd=cwd,
                env=env,
                start_new_session=True,
            )
        except OSError as e:
            if mode == APPEND:
                out.truncate(size)
            put_back(moved, log)
            return cant(f"can't start {command[0]!r}: {e.strerror}")
    if moved and mode == TRUNCATE:
        moved.unlink()
    elif moved:
        print(f"bgrun: moved {log} to {moved}", file=sys.stderr)
    return proc


def cant(problem: str) -> None:
    print(f"bgrun: {problem}", file=sys.stderr)


def wait_and_report(proc: subprocess.Popen, log: Path, tail: int) -> int:
    """Wait for CMD, print how it ended and LOG's last lines, and return its status."""
    started = time.monotonic()
    code = proc.wait()
    status = 128 - code if code < 0 else code  # Popen gives -N for death by signal N
    print(
        f"{proc.pid} exited with status {status} after {time.monotonic() - started:.1f}s"
    )
    try:
        with log.open("rb") as f:
            f.seek(max(0, f.seek(0, os.SEEK_END) - TAIL_BYTES))
            end = f.read().decode(errors="replace")
    except OSError as e:
        print(f"bgrun: can't read {str(log)!r}: {e.strerror}")
        return status
    for line in end.splitlines()[-tail:] if tail else []:
        print(line)
    return status


def rotate(log: Path) -> Path | None:
    """Move a non-empty LOG aside and return where it went, or None if it stayed.

    The new name is LOG plus the time of its last write, numbered if that name is taken."""
    try:
        info = log.lstat()
    except FileNotFoundError:
        return None
    if not stat.S_ISREG(info.st_mode) or info.st_size == 0:
        return None
    stamp = time.strftime("%Y-%m-%dT%H-%M-%S", time.localtime(info.st_mtime))
    moved = log.with_name(f"{log.name}.{stamp}")
    n = 0
    while os.path.lexists(moved):
        n += 1
        moved = log.with_name(f"{log.name}.{stamp}-{n}")
    log.rename(moved)
    return moved


def put_back(moved: Path | None, log: Path) -> None:
    """Undo rotate() after a failed start, so the earlier run's log is LOG again."""
    if not moved:
        return
    try:
        moved.replace(log)
    except OSError as e:
        print(f"bgrun: can't move {moved} back to {log}: {e.strerror}", file=sys.stderr)


def caller_env() -> dict[str, str]:
    """bgrun's environment without what uv added to run bgrun itself: its own environment as VIRTUAL_ENV,
    and that environment's bin first on PATH. Left in, every `uv run` in CMD warns that VIRTUAL_ENV doesn't
    match its project, and a bare `python` in CMD is bgrun's."""
    env = dict(os.environ)
    if env.get("VIRTUAL_ENV") == sys.prefix:
        del env["VIRTUAL_ENV"]
    if "PATH" in env:
        own_bin = os.path.join(sys.prefix, "bin")
        env["PATH"] = os.pathsep.join(
            p for p in env["PATH"].split(os.pathsep) if p != own_bin
        )
    return env


def start_problem(program: str, cwd: str | None, env: dict[str, str]) -> str | None:
    """Why CMD can't start, checked before LOG is opened so a failed start leaves LOG alone."""
    if cwd is not None and not Path(cwd).is_dir():
        return f"-C {cwd!r} is not a directory"
    if "/" in program:
        path = Path(cwd or ".") / program  # Popen resolves a relative path against cwd
        if not (path.is_file() and os.access(path, os.X_OK)):
            return f"can't start {program!r}: not an executable file"
    elif shutil.which(program, path=env.get("PATH")) is None:
        return f"can't start {program!r}: not found on PATH"
    return None


if __name__ == "__main__":
    sys.exit(main())
