#!/usr/bin/env -S uv run --quiet --script
# /// script
# dependencies = ["requests"]
# ///
"""Fetch a paper's metadata, citations or full text from Semantic Scholar and arXiv.

    paper meta ID...
    paper bib ID...
    paper cites ID [--limit N]
    paper search QUERY... [--limit N]
    paper sweep QUERY... [--year Y] [--min-citations N] [--fields-of-study LIST]
                         [--max N] [--top N]
    paper text ID
    paper outline ID
    paper grep ID PATTERN [-C N] [-i]
    paper stats [--hours H]

meta prints one short block per paper: title, year and venue, authors (with
affiliations when Semantic Scholar has them), citation count, its arXiv, DOI
and Semantic Scholar ids, and, for an arXiv paper, its latest version with
the dates of its first and latest versions (one arXiv API request per call).
Pass every id to one meta call: the ids missing from the cache go to Semantic
Scholar as one batch request (up to 500 ids each), not one request apiece.
When Semantic Scholar doesn't know a paper, meta asks OpenAlex, then Crossref
for a DOI, and prints the first answer under a `source:` line naming it; only
when they don't know it either does meta say the paper is not found.
Crossref counts only the citations publishers deposit with it.

bib prints a BibTeX entry per DOI or arXiv id, a blank line between entries,
from doi.org's content negotiation: Crossref's or DataCite's record as it
comes, but keyed by the first author's family name in ASCII letters and the
year (nash1951), with a, b, ... on keys that clash within the call
(kreps1982a, kreps1982b). For an arXiv id (or arXiv DOI), bib first looks
for the paper's version of record: a DOI that isn't arXiv's in Semantic
Scholar's record, when it names a venue that isn't arXiv, else in OpenAlex's,
when OpenAlex lists that DOI's own page as the published version at a
journal or conference. It prints that DOI's entry, keyed by its own year,
with eprint and archiveprefix fields for the arXiv id, and says so on
stderr, unless the entry's title or first author isn't arXiv's latest
version's: then it says which DOI it rejected and why. It looks again once
the records it read are a week old. --preprint skips the lookup.
Otherwise the entry comes through the paper's DataCite DOI
(10.48550/arXiv.ID); its key keeps the first version's year, but its title
and authors follow arXiv's latest version, from the arXiv API as meta's dates
do, and a version = {N} field and a line on stderr say which version that
is. A DOI whose registration agency serves no BibTeX says so, and exits 1
like one doi.org doesn't know, after printing the rest.

cites lists papers citing ID (default 20), search the top matches for a
keyword query (default 10), each with year, title, venue, first three authors
and ids. text downloads the PDF, extracts it with `pdftotext -layout` and
prints the path of the .txt file. A whole paper runs to 10-20k tokens, so
start with outline: its section headings with line numbers, to read just the
sections you need with an offset and limit. grep prints the lines matching a
regex, with their line numbers and 2 lines of context (-C N to change, -i to
ignore case), for finding one number or claim. Both fetch the text first, like
text. outline spots numbered headings ("3 Method", "4.2 Results", "A
Appendix") and the usual section names; when a layout defeats it, grep for a
heading instead.

sweep fetches every paper matching QUERY from Semantic Scholar's bulk search,
most cited first, up to --max (default 1000), optionally only papers from
--year (2024, 2016-2020, 2010-, -2015), with --min-citations, or in
--fields-of-study ("Computer Science,Economics"). When there are more matches
than --max, it fetches again newest first, so the newest papers are there
too. It writes them all to a TSV file in the cache, reused for a day, and
prints how many it fetched, the --top most cited (default 20), the --top
newest the first list doesn't show, and the file's path: grep the file for
the rest. The query is matched against title and abstract, stemmed, and every term must
appear: + is AND, | OR, - NOT, "..." a phrase, * a prefix, ( ) groups, and
~N after a word or phrase allows N edits or N words apart. So keep a query to
2-3 key terms and list synonyms with |, such as
collusion + (LLM | "language model"): a paper that says "tacit coordination"
where the query says "collude" doesn't match. A thin or empty result, from
sweep or search, is a reason to rephrase, not evidence that no such paper
exists. Matches aren't ranked by relevance, so use search for the few best
papers on a topic and sweep for everything that matches. sweep has no
OpenAlex fallback.

stats summarises requests.jsonl in the cache, a line per request paper makes
(service, URL without its query, status, attempts, pacing wait, backoff;
never parameters or keys), per service over the last --hours (default 24):
how requests ended, extra attempts, backoff, pacing waits and the busiest
minute.

ID is an arXiv id (2404.00806, version suffix optional), an arxiv.org abs or
pdf URL, a DOI (10.1145/... bare or as a doi.org URL), or a 40-character
Semantic Scholar paperId. text takes arXiv ids and URLs, DOIs or a direct PDF
URL: an arXiv DOI (10.48550/arXiv....) fetches from arXiv, and any other DOI
fetches the open-access PDF OpenAlex lists, if it lists one. For a paper with
none of these (PMLR, OpenReview), find its paperId with search. bib takes
DOIs and arXiv ids and URLs.

Every answer is cached in $PAPER_CACHE (default
/home/carver/code/claudedev/cache/paper, or ~/.cache/paper on a machine without
/home/carver/code/claudedev/cache): Semantic Scholar responses as JSON,
OpenAlex and Crossref responses likewise in openalex/ and crossref/, BibTeX
entries in bibtex/, arXiv's latest version of each paper (its number, dates,
title and authors) for a day, as new versions appear, PDFs with their text.
Delete the s2 folder there to refetch Semantic Scholar answers (metadata,
citations, searches), or a paper's files in pdf/ to fetch its text anew. If
arXiv can't be reached, meta prints the rest and warns.

Semantic Scholar answers more requests, and 429s less, with an API key. paper
sends one when $S2_API_KEY is set, else when the file
/home/carver/code/claudedev/.semantic-scholar/api-key holds one; it goes only to
Semantic Scholar, never to arXiv or a PDF host. Without a key, requests go
anonymous.

Requests are paced across every paper process that shares the cache, so
agents running paper in parallel stay under the limits: Semantic Scholar's at
least 1.1 seconds apart (a key allows about one a second), OpenAlex's at least
0.15 seconds, Crossref's and doi.org's at least 0.2 seconds, the arXiv API's
at least 3 seconds apart. Each waits its turn on a lock file in the cache.
PDF downloads aren't paced.

Rate limits (HTTP 429, including Semantic Scholar's JSON error object), 5xx
and timeouts are retried with exponential backoff, honouring Retry-After: up
to 6 attempts and 2 minutes of waiting. Don't sleep and retry yourself.

When Semantic Scholar still fails after those retries, meta, search and cites
answer from OpenAlex instead, for arXiv ids and DOIs (a Semantic Scholar
paperId has no OpenAlex form), meta then Crossref for a DOI that OpenAlex
doesn't have, and later lookups in the same run skip Semantic Scholar. A
`source:` line in the output says which answered: OpenAlex counts and
lists far fewer citations than Semantic Scholar for arXiv papers, so rerun
later for Semantic Scholar's numbers, and an empty OpenAlex citer list doesn't
show that nothing cites the paper. OpenAlex and Crossref requests carry
mailto=robocarver@worldofmail.com, and doi.org requests carry it in their
User-Agent, so Crossref, where doi.org sends most of them, answers from its
polite pool. OpenAlex requests also carry an API key
when $OPENALEX_API_KEY is set, else when
/home/carver/code/claudedev/.openalex/api-key holds one; it goes only to
OpenAlex. Without a key, every request from this network shares
one small daily budget. A key OpenAlex refuses (not yet activated, or
invalid) is dropped, with a warning. OpenAlex lists at most 200 papers per
request, so --limit above 200 gets 200.

Exit status: 0 success, 1 not found (or the URL is not a PDF pdftotext can
read, or a DOI has no open-access PDF or no BibTeX; search with no hits exits
1, and so do grep with no matching line and outline with no heading; cites
with no citing papers says so and exits 0), 2 usage error, 3 the remote
refused or failed the request after retries, or sent an unexpected answer,
including Semantic Scholar failing while neither OpenAlex nor Crossref
answers, and OpenAlex or Crossref failing for a paper Semantic Scholar
doesn't know while neither has it: try again later.

Examples:
    paper meta 2404.00806 10.1145/3442188.3445922
    paper bib 10.2307/1969529 1706.03762 >> refs.bib
    paper cites https://arxiv.org/abs/1706.03762 --limit 50
    paper search detect collusion multi-agent games --limit 5
    less "$(paper text 2404.00806)"
    paper text https://doi.org/10.1093/joclec/nhy016
    paper outline 2404.00806
    paper grep 2404.00806 'collusion rate|markup' -C 1
"""

import argparse
import bisect
import calendar
import fcntl
import hashlib
import json
import os
import random
import re
import statistics
import subprocess
import sys
import time
import unicodedata
from collections import Counter
from collections.abc import Callable, Iterator, Sequence
from contextlib import contextmanager
from dataclasses import asdict, dataclass, field, replace
from functools import cached_property
from pathlib import Path
from typing import Any
from urllib.parse import quote, unquote, urlparse, urlsplit
from xml.etree import ElementTree

OK, NOT_FOUND, USAGE, REMOTE = 0, 1, 2, 3
S2 = "https://api.semanticscholar.org/graph/v1"
DEFAULT_CACHE = "/home/carver/code/claudedev/cache/paper"
KEY_ENV = "S2_API_KEY"
KEY_FILE = Path("/home/carver/code/claudedev/.semantic-scholar/api-key")
ARXIV_API = "https://export.arxiv.org/api/query"
ARXIV_TTL = 24 * 3600  # seconds; arXiv's latest versions are refetched after a day
# seconds; bib looks for an arXiv paper's version of record again after a week
VERSION_OF_RECORD_TTL = 7 * 24 * 3600
ATOM = "{http://www.w3.org/2005/Atom}"
TIMEOUT = 30
ATTEMPTS = 6
BUDGET = 120  # seconds of sleeping between attempts, at most
BATCH_MAX = 500  # ids per POST /paper/batch, Semantic Scholar's limit
ISO_UTC = "%Y-%m-%dT%H:%M:%SZ"  # the request log's and the sweep details' timestamps
SWEEP_FIELDS = "title,year,publicationDate,venue,citationCount,externalIds,authors"
SWEEP_TTL = 24 * 3600  # seconds; a sweep's file is fetched again after a day
