#!/usr/bin/env python3
"""Run the pre-commit framework from a repo's pre-commit hook.

    pre-commit-run                  as the hook calls it, from the repo being committed
    pre-commit-run --install REPO   copy this script to REPO/bin/ and call it from REPO's hook

It runs `uvx pre-commit@VERSION run` (4.7.0, or $PRE_COMMIT_VERSION) on what's staged,
and does nothing in a repo without a .pre-commit-config.yaml. A person committing sees
pre-commit's output as it runs. An agent ($AI_AGENT set, as Claude Code sets it) sees it
only when it fails: agents filtered the noisy pass with greps, and the greps hid refused
commits. A refusal ends with a COMMIT REFUSED line either way. pre-commit won't run while
its config has unstaged changes, so that is refused first, with a line saying so.

--install copies this script to REPO/bin/pre-commit-run, so collaborators without
llm-toolbox have it, and adds one line calling it to the pre-commit hook in REPO's hooks
directory: in place of the hook's own `pre-commit run` line when it has one, else after
the shebang (creating a #!/bin/sh hook when there is none, and replacing one that
`pre-commit install` wrote). Running it again changes nothing. Commit bin/pre-commit-run; a hook in .git/hooks isn't committed. In a repo whose
linters cover bin/, exclude the copy from them (ruff's extend-exclude with force-exclude,
pyright's exclude), or ruff format rewrites it away from this one.
It needs only Python 3 and uv, so it runs on a host and in a sandbox alike.
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

VERSION = "4.7.0"
CONFIG = ".pre-commit-config.yaml"
LINE = '"$(git rev-parse --show-toplevel)/bin/pre-commit-run" || exit 1'
SHELLS = {"sh", "bash", "dash", "zsh", "ksh"}
# The mark of a hook `pre-commit install` wrote, which --install replaces whole.
GENERATED = "# File generated by pre-commit"
# A hook's own call of pre-commit, which --install replaces rather than running it twice.
OWN_RUN = re.compile(
    r"^[ \t]*(?:uvx[ \t]+)?pre-commit(?:@\S+)?[ \t]+run\b.*$", re.MULTILINE
)


def refuse(why: str) -> int:
    print(f"COMMIT REFUSED: {why}", file=sys.stderr)
    return 1


def git(*args: str, cwd: Path | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", *args], cwd=cwd, capture_output=True, text=True, check=False
    )


def run() -> int:
    top = git("rev-parse", "--show-toplevel")
    if top.returncode != 0:
        return refuse("not in a git repository")
    repo = Path(top.stdout.strip())
    if not (repo / CONFIG).is_file():
        return 0
    if git("diff", "--quiet", "--", CONFIG, cwd=repo).returncode != 0:
        print(
            f"pre-commit-run: {CONFIG} has unstaged changes, which pre-commit won't "
            "run with; stage it or commit it first",
            file=sys.stderr,
        )
        return refuse(f"{CONFIG} is unstaged")
    if not shutil.which("uvx"):
        return refuse(
            "pre-commit-run needs uvx (uv) on PATH: https://docs.astral.sh/uv/"
        )
    argv = ["uvx", f"pre-commit@{os.environ.get('PRE_COMMIT_VERSION', VERSION)}", "run"]
    if os.environ.get("AI_AGENT"):
        done = subprocess.run(
            argv,
            cwd=repo,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
        )
        if done.returncode != 0:
            sys.stderr.write(done.stdout.decode(errors="replace"))
    else:
        done = subprocess.run(argv, cwd=repo, check=False)
    return refuse("pre-commit failed") if done.returncode != 0 else 0


def is_shell_script(text: str) -> bool:
    first = text.split("\n", 1)[0]
    if not first.startswith("#!"):
        return False
    words = first[2:].split()
    if words and Path(words[0]).name == "env":
        words = words[1:]
    return bool(words) and Path(words[0]).name in SHELLS


class HandEdit(Exception):
    """A hook --install can't edit safely; the message says why."""


def edited_hook(text: str | None) -> tuple[str, str]:
    """(the hook's new text, what changed) for a hook's current text, None when there's
    none. The text is unchanged when it already calls pre-commit-run."""
    fresh = f"#!/bin/sh\n{LINE}\n"
    if text is None:
        return fresh, "created"
    if GENERATED in text:
        return fresh, "replaced the hook `pre-commit install` wrote"
    if not is_shell_script(text):
        raise HandEdit("is not a shell script")
    if LINE in text:
        return text, "already calls pre-commit-run"
    if own := OWN_RUN.search(text):
        if own.group().rstrip().endswith("\\"):
            raise HandEdit("runs pre-commit over several lines")
        return text[: own.start()] + LINE + text[own.end() :], (
            "replaced its own pre-commit run with the call"
        )
    shebang, _, rest = text.partition("\n")
    return f"{shebang}\n{LINE}\n{rest}", "added the call"


def copy_script(repo: Path) -> None:
    source, copy = Path(__file__).resolve(), repo / "bin" / "pre-commit-run"
    if not copy.is_file() or copy.read_bytes() != source.read_bytes():
        copy.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(source, copy)
        copy.chmod(0o755)
        print(f"copied pre-commit-run to {copy}")


def install(repo: Path) -> int:
    hooks = git("rev-parse", "--git-path", "hooks", cwd=repo)
    if hooks.returncode != 0:
        print(f"pre-commit-run: {repo} is not a git repository", file=sys.stderr)
        return 1
    hook = repo / hooks.stdout.strip() / "pre-commit"
    text = hook.read_text() if hook.exists() else None
    try:
        new, change = edited_hook(text)
    except HandEdit as why:
        print(f"pre-commit-run: {hook} {why}, so add the call by hand", file=sys.stderr)
        return 1
    copy_script(repo)
    if new != text:
        hook.parent.mkdir(parents=True, exist_ok=True)
        hook.write_text(new)
        hook.chmod(hook.stat().st_mode | 0o755)
    print(f"{hook}: {change}")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "--install",
        metavar="REPO",
        type=Path,
        help="copy this script into REPO/bin/ and call it from REPO's pre-commit hook",
    )
    args = parser.parse_args(argv)
    return install(args.install.resolve()) if args.install else run()


if __name__ == "__main__":
    sys.exit(main())
