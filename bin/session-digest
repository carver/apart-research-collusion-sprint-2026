#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# ///
"""Condense a Claude Code session, subagents included, for a retrospective.

A session log and each of its subagents' logs run to a megabyte of JSONL, mostly
tool output. This prints a summary of what each agent and each tool cost, then
every agent's timeline: user turns, the assistant's text, one line per tool call
with the size of its output, and the text of every error. A hook that failed
or was cancelled (by a timeout, say) gets a line with its error's last line,
under the tool call it ran for (or where it ran, if it ran for none), and the
summary counts them per hook. Output bodies are left out; their size is given
in characters and estimated tokens (chars / 4).
A background task's notification gets one line, its id, status and summary,
without the report: a subagent's report shows in that agent's own timeline.
An image counts about width * height / 750 tokens, from its header (PNG, GIF,
JPEG), capped at 1600.

Workflow agents (Workflow tool runs) each get a summary row named
<run>:<label>, and their errors and failed hooks are printed with the call
they belong to; --timelines prints their full timelines too.

The session defaults to the newest one for the current directory's project,
or its nearest parent directory's.
Logs live under $CLAUDE_CONFIG_DIR (default ~/.claude) in
projects/<project>/<session>.jsonl, with subagents in
projects/<project>/<session>/subagents/agent-<id>.jsonl and workflow agents in
projects/<project>/<session>/subagents/workflows/<run>/agent-<id>.jsonl.
"""

import argparse
import base64
import binascii
import html
import json
import math
import os
import re
import sys
from collections import Counter
from dataclasses import dataclass, field
from pathlib import Path

TEXT_LIMIT = 400
BIGGEST = 5
INPUT_LIMIT = 200
CHARS_PER_TOKEN = 4
IMAGE_TOKENS = 1600
IMAGE_EDGE = 1568
HOOK_FAILURES = ("hook_non_blocking_error", "hook_cancelled")


@dataclass
class ToolStats:
    calls: int = 0
    errors: int = 0
    tokens: int = 0

    def add(self, error: bool, tokens: int) -> None:
        self.calls += 1
        self.errors += error
        self.tokens += tokens


@dataclass
class Agent:
    name: str
    label: str
    lines: list[str] = field(default_factory=list)
    totals: ToolStats = field(default_factory=ToolStats)
    tools: dict[str, ToolStats] = field(default_factory=dict)
    outputs: list[tuple[int, str]] = field(default_factory=list)
    # The lines that show what failed, by tool call id: the call, then its failed
    # hooks and its error in full. A hook that ran for no call has a key of its own.
    failures: dict[str, list[str]] = field(default_factory=dict)
    hook_errors: Counter[str] = field(default_factory=Counter)
    context_in: int = 0
    output: int = 0
    workflow: bool = False


def short(text: str, limit: int) -> str:
    text = " ".join(text.split())
    if len(text) <= limit:
        return text
    return f"{text[:limit]}…[+{len(text) - limit} chars]"


def human(n: int) -> str:
    return str(n) if n < 1000 else f"{n / 1000:.1f}k"


def describe_input(name: str, tool_input: dict) -> str:
    for key in ("command", "file_path", "pattern", "url", "query", "skill"):
        if key in tool_input:
            return short(str(tool_input[key]), INPUT_LIMIT)
    if name == "Agent" and "description" in tool_input:
        return str(tool_input["description"])
    return short(json.dumps(tool_input), INPUT_LIMIT)


def result_size(content: str | list) -> tuple[str, int, int]:
    """The result's text, its estimated tokens, and how many images it held."""
    if isinstance(content, str):
        return content, len(content) // CHARS_PER_TOKEN, 0
    text = "\n".join(b.get("text", "") for b in content if b.get("type") == "text")
    images = [b for b in content if b.get("type") == "image"]
    tokens = len(text) // CHARS_PER_TOKEN + sum(image_tokens(b) for b in images)
    return text, tokens, len(images)


def image_tokens(block: dict) -> int:
    """About width * height / 750 tokens, after scaling the long edge to IMAGE_EDGE, at
    most IMAGE_TOKENS; IMAGE_TOKENS when the size can't be read from the data's header."""
    size = image_size(str((block.get("source") or {}).get("data", "")))
    if size is None:
        return IMAGE_TOKENS
    width, height = size
    scale = min(1.0, IMAGE_EDGE / max(width, height, 1))
    return min(IMAGE_TOKENS, math.ceil(width * scale * height * scale / 750))


def image_size(data: str) -> tuple[int, int] | None:
    """Width and height from a base64 PNG, GIF or JPEG's header."""
    try:
        head = base64.b64decode(data[: 4 * 16384], validate=False)
    except (binascii.Error, ValueError):
        return None
    if head.startswith(b"\x89PNG\r\n\x1a\n") and len(head) >= 24:
        return int.from_bytes(head[16:20], "big"), int.from_bytes(head[20:24], "big")
    if head[:6] in (b"GIF87a", b"GIF89a") and len(head) >= 10:
        return int.from_bytes(head[6:8], "little"), int.from_bytes(head[8:10], "little")
    if head.startswith(b"\xff\xd8"):
        return jpeg_size(head)
    return None


def jpeg_size(head: bytes) -> tuple[int, int] | None:
    """Walk the JPEG's segments to its start-of-frame marker."""
    at = 2
    while at + 9 < len(head) and head[at] == 0xFF:
        marker, length = head[at + 1], int.from_bytes(head[at + 2 : at + 4], "big")
        if 0xC0 <= marker <= 0xCF and marker not in (0xC4, 0xC8, 0xCC):
            height = int.from_bytes(head[at + 5 : at + 7], "big")
            return int.from_bytes(head[at + 7 : at + 9], "big"), height
        at += 2 + length
    return None


def notification(text: str) -> str | None:
    """One line for a <task-notification> turn, leaving out its report or event body."""
    if not text.lstrip().startswith("<task-notification>"):
        return None

    def tag(name: str) -> str:
        found = re.search(rf"<{name}>(.*?)</{name}>", text, re.DOTALL)
        return html.unescape(found.group(1).strip()) if found else ""

    head = " ".join(filter(None, [tag("task-id"), tag("status")]))
    return f"NOTIFY {head}: {short(tag('summary'), TEXT_LIMIT)}"


def hook_failure(attachment: dict) -> tuple[str, str] | None:
    """For a hook that failed or was cancelled, the hook (its event and command) and
    the last line of its error; None for any other attachment."""
    if attachment.get("type") not in HOOK_FAILURES:
        return None
    hook = f"{attachment.get('hookName', '?')} {attachment.get('command', '?')}"
    if attachment["type"] == "hook_cancelled":
        timeout = attachment.get("timeoutMs")
        if attachment.get("timedOut") and timeout:
            return hook, f"timed out after {timeout / 1000:g}s"
        return hook, "cancelled"
    output = (attachment.get("stderr") or "").strip() or (
        attachment.get("stdout") or ""
    ).strip()
    if not output:
        return hook, f"exit {attachment.get('exitCode')}"
    return hook, output.splitlines()[-1]


def read_jsonl(path: Path) -> list[dict]:
    records = []
    for line in path.read_text().splitlines():
        try:
            records.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return records


def hook_line(failure: tuple[str, str]) -> str:
    hook, error = failure
    return f"    HOOK ERROR {hook}: {short(error, TEXT_LIMIT)}"


def hook_lines(records: list[dict]) -> dict[str, list[str]]:
    """Each tool call's failed hooks, one line each. The log may put a hook's record
    before its call's, so they are gathered first."""
    calls = {
        block["id"]
        for record in records
        if record.get("type") == "assistant"
        for block in (record.get("message") or {}).get("content") or []
        if block.get("type") == "tool_use"
    }
    found: dict[str, list[str]] = {}
    for record in records:
        attachment = record.get("attachment") or {}
        failure = hook_failure(attachment)
        if failure and attachment.get("toolUseID") in calls:
            found.setdefault(attachment["toolUseID"], []).append(hook_line(failure))
    return found


def digest(agent: Agent, records: list[dict], spawned: dict[str, str]) -> Agent:
    pending: dict[str, tuple[str, str]] = {}
    requests: set[str] = set()
    hooks_by_call = hook_lines(records)
    for record in records:
        message = record.get("message") or {}
        content = message.get("content")
        if record.get("type") == "attachment":
            attachment = record.get("attachment") or {}
            if failure := hook_failure(attachment):
                hook, _ = failure
                agent.hook_errors[hook] += 1
                # A hook that ran for no tool call prints where it ran.
                if attachment.get("toolUseID") not in hooks_by_call:
                    agent.lines.append(hook_line(failure))
                    agent.failures[f"hook {len(agent.failures)}"] = [hook_line(failure)]
        elif record.get("type") == "assistant":
            request = record.get("requestId") or message.get("id")
            usage = message.get("usage")
            if usage and request not in requests:
                requests.add(request)
                agent.context_in += (
                    usage.get("input_tokens", 0)
                    + usage.get("cache_creation_input_tokens", 0)
                    + usage.get("cache_read_input_tokens", 0)
                )
                agent.output += usage.get("output_tokens", 0)
            for block in content or []:
                if block.get("type") == "text":
                    agent.lines.append(f"  {short(block['text'], TEXT_LIMIT)}")
                elif block.get("type") == "tool_use":
                    call = f"{block['name']}: {describe_input(block['name'], block.get('input', {}))}"
                    pending[block["id"]] = (block["name"], call)
                    line = f"  > {call}"
                    if block["id"] in spawned:
                        line += f" -> {spawned[block['id']]}"
                    agent.lines.append(line)
                    if hooks := hooks_by_call.get(block["id"]):
                        agent.lines += hooks
                        agent.failures[block["id"]] = [
                            f"  > {call}",
                            *hooks,
                        ]
        elif record.get("type") == "user":
            if isinstance(content, str):
                if record.get("isMeta"):
                    agent.lines.append(f"USER (injected, {len(content)} chars)")
                elif notice := notification(content):
                    agent.lines.append(notice)
                else:
                    agent.lines.append(f"USER {short(content, TEXT_LIMIT * 5)}")
                continue
            for block in content or []:
                if block.get("type") == "text" and not record.get("isMeta"):
                    agent.lines.append(f"USER {short(block['text'], TEXT_LIMIT * 5)}")
                elif block.get("type") == "tool_result":
                    tool, call = pending.pop(block.get("tool_use_id"), ("?", "?"))
                    text, tokens, images = result_size(block.get("content") or "")
                    error = bool(block.get("is_error"))
                    agent.totals.add(error, tokens)
                    agent.tools.setdefault(tool, ToolStats()).add(error, tokens)
                    agent.outputs.append((tokens, call))
                    if error:
                        agent.lines.append(f"    ERROR {short(text, TEXT_LIMIT)}")
                        full = text.strip().replace("\n", "\n          ")
                        agent.failures.setdefault(
                            block.get("tool_use_id"), [f"  > {call}"]
                        ).append(f"    ERROR {full}")
                    else:
                        size = f"{len(text)} chars ~{tokens} tok"
                        if images:
                            size += f" ({images} images)"
                        agent.lines.append(f"    = {size}")
    return agent


def project_dir(config: Path, cwd: str) -> Path:
    """The project folder for cwd, or for its nearest ancestor that has one.

    The shell often drifts into a subfolder of the project Claude Code was
    started in, and only that starting folder has a project folder.
    """
    for folder in [cwd, *map(str, Path(cwd).parents)]:
        project = config / "projects" / re.sub(r"[^A-Za-z0-9]", "-", folder)
        if project.is_dir():
            return project
    return config / "projects" / re.sub(r"[^A-Za-z0-9]", "-", cwd)


def find_session(config: Path, cwd: str, session: str | None) -> Path | None:
    if session and Path(session).is_file():
        return Path(session)
    project = project_dir(config, cwd)
    if session:
        path = project / f"{session}.jsonl"
        if path.is_file():
            return path
        matches = list((config / "projects").glob(f"*/{session}.jsonl"))
        return matches[0] if len(matches) == 1 else None
    logs = sorted(project.glob("*.jsonl"), key=lambda p: p.stat().st_mtime)
    return logs[-1] if logs else None


def load_subagents(session: Path) -> list[tuple[str, dict, list[dict]]]:
    return load_subagents_in(session.with_suffix("") / "subagents")


def load_subagents_in(folder: Path) -> list[tuple[str, dict, list[dict]]]:
    found = []
    for log in sorted(folder.glob("agent-*.jsonl"), key=lambda p: p.stat().st_mtime):
        meta_path = log.with_suffix(".meta.json")
        meta = json.loads(meta_path.read_text()) if meta_path.is_file() else {}
        found.append((log.stem, meta, read_jsonl(log)))
    return found


def load_workflow_agents(session: Path) -> list[tuple[str, dict, list[dict]]]:
    """Agents of the session's workflow runs, named <run>:<label> (run id without wf_),
    plus #<agent id tail> when two agents in one run share a label."""
    folder = session.with_suffix("") / "subagents" / "workflows"
    found = []
    for run in sorted(folder.glob("*/"), key=lambda p: p.stat().st_mtime):
        agents = load_subagents_in(run)
        labels = [meta.get("description") or name for name, meta, _ in agents]
        for (name, meta, records), label in zip(agents, labels, strict=True):
            suffix = (
                f"#{name.removeprefix('agent-')[:6]}" if labels.count(label) > 1 else ""
            )
            found.append(
                (f"{run.name.removeprefix('wf_')}:{label}{suffix}", meta, records)
            )
    return found


def summary(agents: list[Agent]) -> list[str]:
    width = max(24, *(len(a.name) for a in agents))  # workflow names run long
    row = f"{{:<{width}}} {{:>6}} {{:>6}} {{:>9}} {{:>10}} {{:>8}}"
    lines = [row.format("agent", "calls", "errors", "out~tok", "api-in", "api-out")]
    for a in agents:
        t = a.totals
        lines.append(
            row.format(
                a.name,
                t.calls,
                t.errors,
                human(t.tokens),
                human(a.context_in),
                human(a.output),
            )
        )
    tools: dict[str, ToolStats] = {}
    for a in agents:
        for name, s in a.tools.items():
            total = tools.setdefault(name, ToolStats())
            total.calls += s.calls
            total.errors += s.errors
            total.tokens += s.tokens
    trow = "{:<24} {:>6} {:>6} {:>9}"
    lines += ["", trow.format("tool", "calls", "errors", "out~tok")]
    for name, s in sorted(tools.items(), key=lambda kv: -kv[1].tokens):
        lines.append(trow.format(name, s.calls, s.errors, human(s.tokens)))
    lines += [
        "",
        "out~tok: tool output the agent read, estimated. api-in: context sent per",
        "request, summed (cache reads included). api-out: tokens generated.",
        "",
        "biggest outputs",
    ]
    outputs = [(tokens, a.name, call) for a in agents for tokens, call in a.outputs]
    for tokens, name, call in sorted(outputs, key=lambda o: -o[0])[:BIGGEST]:
        lines.append(f"{human(tokens):>7}  {name:<{width}} {short(call, 100)}")
    hook_errors = sum((a.hook_errors for a in agents), Counter())
    if hook_errors:
        lines += ["", "hook errors"]
        for hook, count in hook_errors.most_common():
            lines.append(f"{count:>7}  {short(hook, 100)}")
    return lines


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="session-digest",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "session",
        nargs="?",
        help="session id or path to its .jsonl (default: newest for --cwd)",
    )
    parser.add_argument(
        "--cwd",
        default=os.getcwd(),
        help="project directory whose sessions to search (default: current)",
    )
    parser.add_argument(
        "--timelines",
        action="store_true",
        help="also print workflow agents' full timelines (default: only their failed calls)",
    )
    args = parser.parse_args(argv)

    config = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude"))
    session = find_session(config, args.cwd, args.session)
    if session is None:
        print(
            f"session-digest: no session {args.session or ''} for {args.cwd} under {config}",
            file=sys.stderr,
        )
        return 1

    subagents = load_subagents(session)
    spawned = {
        meta["toolUseId"]: name for name, meta, _ in subagents if "toolUseId" in meta
    }
    agents = [digest(Agent("main", "main"), read_jsonl(session), spawned)]
    for name, meta, records in subagents:
        label = f"{meta.get('agentType', '?')}: {meta.get('description', '')}"
        agents.append(digest(Agent(name, label), records, spawned))
    for name, meta, records in load_workflow_agents(session):
        label = f"workflow phase {meta.get('workflowPhase', '?')}"
        agents.append(digest(Agent(name, label, workflow=True), records, spawned))

    print(f"session {session.stem}  ({session})")
    print("\n".join(summary(agents)))
    for agent in agents:
        if agent.workflow and not args.timelines:
            continue
        header = "main" if agent.name == "main" else f"{agent.name} ({agent.label})"
        print(f"\n== {header}")
        print("\n".join(agent.lines))
    failed = [a for a in agents if a.workflow and a.failures]
    if failed and not args.timelines:
        print(
            "\n== workflow agents' failed calls (--timelines prints their full timelines)"
        )
        for agent in failed:
            print(f"-- {agent.name} ({agent.label})")
            for lines in agent.failures.values():
                print("\n".join(lines))
    return 0


if __name__ == "__main__":
    sys.exit(main())
